# ==========================================
# Maveli Restaurant - Environment Configuration
# ==========================================

# Application Environment (development | production)
VITE_APP_ENV=development

# Base URL
VITE_SITE_URL=https://mavelirestaurant.in

# Firebase Configuration (for Auth & Firestore)
# Create a project in Firebase Console (https://console.firebase.google.com)
# Enable Email/Password Auth and Firestore Database
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Owner Credentials / Admin Email
# This email is given administrative access to the /owner dashboard
VITE_OWNER_EMAIL=owner@mavelirestaurant.in

# Payment Gateway Configuration (India: Razorpay)
# Sign up at https://dashboard.razorpay.com and generate test keys
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Google Maps / Places API (Optional: for live Google reviews or map autocomplete)
# If left empty, fallback static verified data from src/data/ is used
VITE_GOOGLE_PLACES_API_KEY=

# Google Analytics 4 (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Instagram Token (Optional: for live feed API integration)
# If left empty, curated verified posts from src/data/instagram.js are used
VITE_INSTAGRAM_ACCESS_TOKEN=

